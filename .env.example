NODE_ENV=production|development
PORT=3000

DATABASE_URL=postgresql://...                 # Supabase connection string (session pooler)
# Use the Session Pooler or Shared Pooler (Supavisor) string from Project
# Settings → Database → Connection string — NOT "Direct connection".
# Confirmed as of this writing: Supabase's direct-connection host is
# IPv6-only unless your project has the paid IPv4 add-on, and Render's
# outbound networking is IPv4 — a direct-connection string simply won't
# connect from Render. Pooler connection strings use username format
# `postgres.<project-ref>` (not plain `postgres`) — copy the exact string
# from your dashboard rather than hand-editing one.
DATABASE_SSL_DISABLE=false                    # leave false/unset for Supabase — see db.js

PLAID_CLIENT_ID=...
PLAID_SECRET=...
PLAID_ENV=sandbox|production                  # verify current valid values against your Plaid dashboard before deploy

ENCRYPTION_KEY=<base64, 32 bytes>              # generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=<base64, 64 bytes>                  # generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# Access-token TTL (15m) and refresh-token TTL (30d) are fixed constants in
# routes/auth.js, not environment-configurable — the refresh-rotation design
# depends on the access token staying short-lived. There is no JWT_EXPIRES_IN
# var: an earlier package revision had one, but it only ever affected a
# duplicate/dead auth implementation (src/auth/auth.js) that has been removed.

CORS_ORIGIN=https://your-frontend-domain
API_PUBLIC_URL=https://your-api-domain
SERVICE_DATABASE_URL=postgresql://<service-role>:<password>@<host>:<port>/<database>
WEBHOOK_PUBLIC_URL=https://your-api-domain/plaid/webhook
# Must be a live, publicly reachable HTTPS URL before Plaid will send
# webhooks — Render's default *.onrender.com URL works once deployed;
# localhost/ngrok URLs only work while that tunnel session is open, and Plaid
# has no way to know a tunnel URL changed between sessions.
PLAID_OAUTH_REDIRECT_URI=                     # optional — only needed for OAuth-flow institutions; see adapter.js. No frontend ships in this package to receive the redirect.
SMTP_HOST=...
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=...
SMTP_PASSWORD=...
SMTP_FROM=no-reply@your-domain.example
FRONTEND_RESET_URL=https://your-frontend-domain/reset-password
FRONTEND_EMAIL_VERIFY_URL=https://your-frontend-domain/verify-email  # reserved: no email-verification route ships yet — see IMPLEMENTATION_MANIFEST.md

RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_LOGIN_WINDOW_MS=900000              # 15 minutes

# apps/api/src/worker.js — separate process (`npm run worker`), all optional,
# defaults shown:
WORKER_WEBHOOK_POLL_MS=5000
WORKER_INCOME_REVIEW_POLL_MS=60000
WORKER_RECONCILIATION_POLL_MS=3600000
WORKER_INTELLIGENCE_POLL_MS=3600000
WORKER_BATCH_SETTLEMENT_POLL_MS=86400000
