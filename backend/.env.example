# Copy to .env for local dev. In Render, set these as real environment variables
# on the web service instead of committing a .env file.

PORT=4000
NODE_ENV=development

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Comma-separated list, e.g. transactions,liabilities,balance,investments
PLAID_PRODUCTS=transactions,balance,liabilities
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=https://your-backend.onrender.com/webhooks/plaid

# Supabase — use the SERVICE ROLE key here (backend only, never shipped to frontend)
SUPABASE_URL=https://uhcrdehjwaghqvydaqnn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Round-up simulation config
ROUNDUP_SWEEP_THRESHOLD=2.00
ROUNDUP_SAFETY_BUFFER=10.00
